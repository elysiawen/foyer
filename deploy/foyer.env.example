# 复制到 /etc/foyer/foyer.env，权限设为 600
# 只监听回环地址，公网流量由 Caddy 转发进来
FOYER_ADDR=127.0.0.1:9100
FOYER_DB=/opt/foyer/foyer.db

# 门户所在域名（应用都挂在它的路径下）
FOYER_BASE_DOMAIN=elysia.cc
# 会话 cookie 域；单域名路径式部署写这个域名即可
FOYER_COOKIE_DOMAIN=foyer.elysia.cc
FOYER_SECURE_COOKIE=true

# 首次启动时创建的管理员；密码留空会自动生成并打印到 journalctl
FOYER_ADMIN_USER=admin
FOYER_ADMIN_PASSWORD=

# 应用健康探测间隔
FOYER_PROBE_INTERVAL=30s
# 会话有效期，168h = 7 天
FOYER_SESSION_TTL=168h
